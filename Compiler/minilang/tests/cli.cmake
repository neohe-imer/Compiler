function(check_exit expected)
  execute_process(COMMAND "${MINILANG}" ${ARGN} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${error}")
  endif()
endfunction()
check_exit(2)
check_exit(2 --unknown)
check_exit(2 one.ml two.ml)
check_exit(2 --mode=invalid nonexistent.ml)
check_exit(1 nonexistent.ml)
set(example "${CMAKE_CURRENT_LIST_DIR}/../examples.ml")
foreach(mode interp vm)
  execute_process(COMMAND "${MINILANG}" "--mode=${mode}" "${example}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  string(REPLACE "\r\n" "\n" output "${output}")
  if(NOT result EQUAL 0 OR NOT output STREQUAL "0.000000\n1.000000\n2.000000\n3.000000\n4.000000\n123.000000\n")
    message(FATAL_ERROR "Example failed in ${mode}: ${output} ${error}")
  endif()
endforeach()
